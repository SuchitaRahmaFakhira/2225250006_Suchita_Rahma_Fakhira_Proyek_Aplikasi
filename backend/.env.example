# Salin menjadi .env lalu isi nilainya. File .env TIDAK boleh di-commit.
# Kunci rahasia untuk sesi halaman guru (isi dengan teks acak yang panjang).
SECRET_KEY=ganti-dengan-teks-acak-panjang
# Kunci untuk membuka halaman rekap nilai di /guru (hanya guru/peneliti yang tahu).
KUNCI_GURU=ganti-dengan-kunci-guru
# Opsional: lokasi database (bawaan: backend/instance/data.db)
# DATABASE=/home/username/polaku/backend/instance/data.db
